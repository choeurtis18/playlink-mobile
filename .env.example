# ─────────────────────────────────────────────────────────────
# Playlink Mobile — variables d'environnement (modèle)
# Copier en `.env` et remplir. Le `.env` n'est JAMAIS commité.
# Comptes de services rattachés à gamesplaylink@gmail.com.
# ─────────────────────────────────────────────────────────────

# ── Base cloud : Neon Postgres ────────────────────────────────
# Projet Neon existant : empty-mode-79328479 (branche production).
# NOTE : créé en direct sur neon.tech, pas via la Marketplace Vercel.
# Voir docs/phase-0-etat.md — arbitrage à faire avant la phase 1.
# Pooled (runtime applicatif) :
DATABASE_URL=
# Direct, port 5432 (migrations Prisma — jamais le pooler) :
DIRECT_URL=

# ── Auth éditeurs back-office : Clerk ─────────────────────────
# Instance Clerk séparée de celle des joueurs (ne jamais mélanger les
# deux, CLAUDE.md). Noms de variables imposés tels quels par @clerk/nextjs
# (apps/backoffice) — ne pas les suffixer, le SDK ne les retrouverait plus.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Auth joueurs : Clerk ─────────────────────────
# Instance Clerk séparée de celle des éditeurs ci-dessus. Consommée par
# l'app mobile (clerk_flutter) via --dart-define, pas par Next.js — libre
# de son propre nommage, suffixée _PLAYERS pour ne pas la confondre.
CLERK_PUBLISHABLE_KEY_PLAYERS=
CLERK_SECRET_KEY_PLAYERS=

# ── Stockage snapshots + GIF : Vercel Blob ────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Analytics : PostHog Cloud EU ──────────────────────────────
# Région UE obligatoire (RGPD) : host = https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Migration du contenu (phase 1, scripts/) ──────────────────
# Accès LECTURE à la Supabase de prod de l'app web actuelle.
# URL de connexion DIRECTE, port 5432 (pas le pooler) — pour pg_dump.
LEGACY_SUPABASE_DIRECT_URL=
# Base d'URL des ~100 GIF de règles, si servis depuis un CDN/bucket :
LEGACY_ASSETS_BASE_URL=

# ── Sécurité des endpoints de contenu/sync ────────────────────
# Secret partagé app mobile ↔ back-office pour POST /sync (phase 4).
SYNC_SHARED_SECRET=

# ── Landing page : apps/web ────────────────────────────────────
# Domaine acheté chez Gandi (voir plan landing, phase 1). Utilisé
# pour robots.txt, sitemap.xml et les metadata Open Graph/canonical.
NEXT_PUBLIC_SITE_URL=https://playlink-game.fr
# URL du back-office (apps/backoffice) : seule source du contenu de la
# landing (GET /api/site-config, GET /api/preview-content). apps/web ne
# se connecte jamais directement à Neon — voir plan landing §01.
BACKOFFICE_URL=http://localhost:3000
# Projet PostHog dédié "Playlink — Landing", séparé de l'app mobile
# (ne pas réutiliser NEXT_PUBLIC_POSTHOG_KEY ci-dessus). Chargé côté
# client uniquement après consentement cookies.
NEXT_PUBLIC_POSTHOG_KEY_LANDING=
NEXT_PUBLIC_POSTHOG_HOST_LANDING=https://eu.i.posthog.com
# Protection des routes /api/cron/* (Vercel Cron) :
CRON_SECRET=
