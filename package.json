{
  "name": "playlink-mobile",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "backoffice:dev": "pnpm --filter @playlink/backoffice dev",
    "backoffice:build": "pnpm --filter @playlink/backoffice build",
    "mobile:run": "cd apps/mobile && flutter run",
    "mobile:test": "cd apps/mobile && flutter test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
